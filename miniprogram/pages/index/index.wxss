/* 和网页版手机布局（index.html 里 max-width: 760px 那一段 + home-ui.css + rank-compare.css）一致 */
.app { position: fixed; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; background: var(--desk); }
.map { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.float { position: absolute; z-index: 10; }
.panel { background: var(--panel); color: var(--ink); border: 2px solid var(--ink); border-radius: 16px; box-shadow: 0 4px 12px rgba(40, 28, 16, .16); }

/* 标题栏 */
.brandbar { left: 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 8px 4px 12px; }
.brandbar .h1 { flex: 1 1 0; min-width: 0; font-family: var(--display); font-size: 19px; line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.langs { flex: none; display: flex; border: 2px solid var(--ink); border-radius: 999px; overflow: hidden; background: var(--panel); }
.lb { font-size: 12px; padding: 3px 8px; white-space: nowrap; }
.lb + .lb { border-left: 2px solid var(--ink); }
.lb.on { background: var(--ink); color: var(--panel); font-weight: 700; }
.infobtn { flex: none; width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--ink); background: var(--panel-2); font-weight: 700; font-family: Georgia, serif; display: flex; align-items: center; justify-content: center; font-size: 14px; }
.infopop { left: 8px; right: 8px; z-index: 13; padding: 12px 14px; font-size: 12.5px; line-height: 1.5; color: var(--ink-soft); }

/* 缩放 + 底部按钮 */
.planfab { left: 12px; bottom: calc(66px + env(safe-area-inset-bottom)); font-family: var(--hand); font-size: 16px; padding: 6px 12px; border-radius: 999px; border: 2px solid var(--ink); background: var(--panel); box-shadow: 0 4px 12px rgba(40, 28, 16, .16); display: flex; align-items: center; gap: 6px; }
.pf-n { min-width: 20px; height: 20px; line-height: 20px; text-align: center; font-family: var(--body); font-size: 12px; font-weight: 700; color: #fff; background: #b5462f; border-radius: 999px; padding: 0 5px; }
.zoom { right: 12px; bottom: calc(66px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 6px; }
.zb { width: 40px; height: 40px; font-family: var(--hand); font-size: 26px; line-height: 1; border-radius: 12px; border: 2px solid var(--ink); background: var(--panel); box-shadow: 0 4px 12px rgba(40, 28, 16, .16); display: flex; align-items: center; justify-content: center; }
.zb.fit { width: auto; min-width: 40px; padding: 0 8px; font-size: 15px; white-space: nowrap; }
.zb.off { opacity: .45; }
.mbar { position: absolute; z-index: 15; left: 50%; transform: translateX(-50%); bottom: calc(12px + env(safe-area-inset-bottom)); display: flex; gap: 8px; white-space: nowrap; }
.mb { font-family: var(--hand); font-size: 17px; padding: 7px 16px; border-radius: 999px; border: 2px solid var(--ink); background: var(--panel); box-shadow: 0 4px 12px rgba(40, 28, 16, .16); }
.mb.match { background: var(--accent); color: var(--accent-ink); }

/* 卡片（网页 .card.sheet / .card.compact） */
.card { position: fixed; z-index: 30; background: #fffaf0; color: #3b2a1a; border: 3px solid #3b2a1a; border-radius: 16px; padding: 14px 16px 16px;
  box-shadow: var(--lift-hi); font-size: 14px; line-height: 1.45; transform: rotate(-.5deg); overflow-y: auto; }
.card.compact { left: 12px; bottom: calc(66px + env(safe-area-inset-bottom)); width: calc(100% - 82px); max-width: 360px; max-height: 35vh; padding: 10px 12px 12px; }
.card.sheet { left: 0; right: 0; bottom: 0; border-radius: 20px 20px 0 0; border-bottom: 0; transform: none; max-height: 60vh;
  padding: 14px 18px calc(22px + env(safe-area-inset-bottom)); }
.card .x { position: absolute; top: 2px; right: 2px; width: 44px; height: 44px; font-size: 24px; line-height: 44px; text-align: center; }
.tag { display: inline-block; font-size: 11.5px; font-weight: 700; letter-spacing: .06em; color: #fff; border-radius: 999px; padding: 2px 10px; }
.card .h3 { margin: 6px 26px 2px 0; font-family: var(--display); font-size: 25px; line-height: 1.05; }
.card.compact .h3 { font-size: 22px; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.compact-facts { display: flex; flex-wrap: wrap; gap: 4px 10px; margin: 6px 0 3px; font-size: 13px; }
.compact-facts .strong { font-weight: 700; }
.compact-note { margin: 0 0 8px; color: #6e5538; font-size: 11px; }
.addr { margin: 0 0 8px; font-size: 12.5px; color: #6e5538; }
.txt { margin: 0 0 10px; }
.walks { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.wk { font-family: var(--hand); font-size: 14.5px; background: #f8efd9; border: 1.5px solid #dcc8a0; border-radius: 8px; padding: 1px 8px; }
.facts { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0 0 12px; font-size: 13px; }
.facts .b { font-weight: 700; }
.actions2 { display: flex; gap: 8px; margin: 10px 0; flex-wrap: wrap; }
.ha { font-size: 13px; border: 1.5px solid #3b2a1a; border-radius: 9px; padding: 7px 10px; background: #f8efd9; color: #3b2a1a; line-height: 1.2; }
.ha.on { background: #2c5c8a; color: #fffaf0; }
.src { margin: 8px 0 0; font-size: 11px; color: #6e5538; }
.acts { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 4px; }
.card.compact .acts { gap: 6px; }
.cta { font-family: var(--hand); font-size: 17px; padding: 5px 13px; border-radius: 10px; background: #b5462f; color: #fff; border: 2px solid #3b2a1a; min-height: 40px; display: flex; align-items: center; }
.card.compact .cta { font-size: 15px; padding: 5px 9px; }
.detail-toggle { min-height: 40px; padding: 5px 10px; border: 1.5px solid #dcc8a0; border-radius: 10px; background: #f8efd9; font-size: 14px; display: flex; align-items: center; }
.cmpb { font-family: var(--hand); font-size: 16px; padding: 4px 11px; border-radius: 10px; background: #fffaf0; color: #3b2a1a; border: 2px solid #3b2a1a; }
.cmpb.on { background: #3b2a1a; color: #fffaf0; }

/* 抽屉（网页 .controls / .homes 在手机上从底部拉出） */
.sheet-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 19; }
.drawer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; max-height: 72%; border-radius: 20px 20px 0 0; border-bottom: 0;
  display: flex; flex-direction: column; transform: translateY(110%); transition: transform .25s ease; padding-bottom: env(safe-area-inset-bottom); }
.drawer.open { transform: none; }
.drawer.homes { height: 72%; }
.phead { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px 8px; flex: none; }
.phead .h2 { font-family: var(--display); font-size: 22px; line-height: 1.1; }
.homes .phead .h2 { font-size: 20px; }
.pbtn { border: 2px solid var(--ink); background: var(--panel-2); border-radius: 999px; padding: 3px 10px; font-size: 13px; white-space: nowrap; }
.pbody { flex: 1; min-height: 0; height: 100%; }
.controls .pbody { padding: 0 12px 12px; }
.pad-bottom { height: 16px; }

.home-search { padding: 3px 12px 10px; display: flex; flex-direction: column; gap: 7px; }
.home-search .lbl { font-weight: 700; font-size: 13px; }
.search { font-size: 16px; min-height: 42px; width: 100%; padding: 9px 10px; border: 2px solid var(--ink); border-radius: 10px; background: var(--panel); color: var(--ink); }
.home-search-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12px; }
.sbtn { min-height: 40px; display: flex; align-items: center; border: 1.5px solid var(--ink); border-radius: 9px; padding: 7px 10px; background: var(--panel-2); }
.sbtn.on { background: var(--home); color: var(--panel); }
.local-note, .stable-note, .filter-note { font-size: 11px; line-height: 1.5; color: var(--ink-soft); }
.stable-note { display: block; padding: 0 12px 7px; }
.filter-note { display: block; margin: 8px 0; }

/* 排序（rank-compare.css）+ 手绘下拉（fancy-select） */
.pc-sort { display: flex; flex-direction: column; gap: 4px; padding: 0 16px 8px; }
.flbl { font-family: var(--hand); font-size: 17px; }
.flbl.small { font-family: var(--body); font-size: 12px; font-weight: 700; }
.fsel { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 16px; min-height: 44px; padding: 7px 9px; border-radius: 10px; border: 2px solid var(--ink); background: var(--panel-2); }
.fsel.ranked { border-color: #b5462f; background: #fff3c4; }
.caret { font-size: 16px; line-height: 1; }
.fs-list { border: 2px solid var(--ink); border-radius: 10px; background: var(--panel); overflow: hidden; box-shadow: 0 6px 16px rgba(40, 28, 16, .18); }
.fs-opt { padding: 10px 12px; font-size: 15px; border-bottom: 1px dashed var(--line); }
.fs-opt:last-child { border-bottom: 0; }
.fs-opt.on { background: var(--ink); color: var(--panel); font-weight: 700; }
.pc-sortnote { font-size: 11.5px; line-height: 1.45; color: #6e5538; }

/* 列表行 */
.gh { margin: 8px 14px 2px; font-family: var(--hand); font-size: 16px; color: var(--ink-soft); border-bottom: 1.5px dashed var(--line); }
.hrow { display: flex; align-items: center; gap: 4px; border-radius: 9px; margin: 0 8px; }
.hbtn { flex: 1; min-width: 0; min-height: 44px; display: flex; align-items: center; gap: 7px; padding: 5px 4px 5px 6px; }
.hbtn .n { flex: none; width: 22px; height: 22px; border-radius: 50%; background: var(--home); color: var(--panel); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.hbtn .nm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13.5px; }
.hbtn .w { flex: none; font-family: var(--hand); font-size: 14px; color: var(--ink-soft); white-space: nowrap; }
.rk { flex: none; width: 22px; text-align: right; font-weight: 800; font-size: 12px; color: #a08b6a; }
.rk.top { color: #9a6a00; }
.fav-mini { flex: none; width: 30px; min-height: 40px; display: flex; align-items: center; justify-content: center; font-size: 23px; color: var(--home); line-height: 1; }
.cbtn { flex: none; width: 28px; min-height: 30px; height: 30px; border-radius: 7px; border: 2px solid var(--ink-soft); background: var(--panel); font-weight: 700; color: var(--ink-soft); display: flex; align-items: center; justify-content: center; }
.cbtn.on { background: var(--accent); border-color: var(--ink); color: var(--accent-ink); }
.empty-homes { padding: 20px 12px; text-align: center; line-height: 1.6; display: flex; flex-direction: column; align-items: center; gap: 10px; }

/* 找公寓 */
.filter-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.filter-footer { display: flex; gap: 8px; justify-content: space-between; margin-bottom: 10px; }
.fbtn { border: 1.5px solid var(--ink); border-radius: 9px; padding: 7px 10px; background: var(--panel-2); min-height: 40px; display: flex; align-items: center; }
.fbtn.main { background: var(--accent); color: var(--accent-ink); font-weight: 700; }
.toggles { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px; }
.chip { font-family: var(--hand); font-size: 15px; line-height: 1; padding: 5px 9px 4px; border-radius: 999px; border: 2px solid var(--ink); background: var(--panel); display: flex; align-items: center; gap: 5px; }
.chip .sw { width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid #3b2a1a; }
.chip.off { opacity: .5; text-decoration: line-through; border-style: dashed; }
.zonekey { display: flex; flex-direction: column; gap: 3px; font-family: var(--hand); font-size: 14px; color: var(--ink-soft); }
.zi { display: inline-block; width: 11px; height: 11px; border-radius: 3px; border: 1.5px solid #3b2a1a; margin-right: 6px; vertical-align: -1px; }

/* 我的专家群气泡（网页 booking-handoff.css 的 .bh-fab） */
.bh-fab { position: fixed; z-index: 45; right: 12px; bottom: calc(222px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 7px; padding: 8px 14px 8px 10px;
  border: 2.5px solid #3b2a1a; border-radius: 999px; background: #fffaf0; color: #3b2a1a; font-family: var(--hand); font-size: 16px;
  box-shadow: 3px 4px 0 rgba(59, 42, 26, .3), 0 10px 24px rgba(40, 28, 16, .2); }
.bh-fab-ico { font-size: 18px; line-height: 1; }
.bh-fab.waiting .bh-fab-label::after { content: "…"; }
.bh-dot { position: absolute; top: -9px; right: -6px; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 10px; background: #b5462f; color: #fff; font: 800 12px/20px var(--body); text-align: center; border: 2px solid #fffaf0; }

/* 房型与照片（网页 room-photos.css） */
.rp { display: flex; flex-direction: column; gap: 4px; margin: 0 0 10px; }
.rp-title { font-family: var(--hand); font-size: 15px; letter-spacing: .12em; text-transform: uppercase; color: #b5462f; }
.rp-note { font-size: 11.5px; color: #6e5538; line-height: 1.4; }
.rp-sub { margin-top: 4px; font-family: var(--hand); font-size: 15px; color: #6e5538; }
.rp-src { margin-top: 2px; font-size: 11px; color: #6e5538; }
.rp-hint { margin-top: 4px; font-size: 12px; color: #974128; }
.rp-strip { white-space: nowrap; padding: 8px 2px 6px; }
.rp-card { display: inline-flex; vertical-align: top; width: 156px; margin-right: 10px; flex-direction: column; gap: 5px; white-space: normal; color: #3b2a1a; }
.rp-stack { position: relative; display: block; height: 104px; }
.rp-img { position: absolute; left: 0; top: 0; width: 100%; height: 92px; border: 5px solid #fff; outline: 2px solid #3b2a1a; border-radius: 3px; box-shadow: 2px 3px 0 rgba(59, 42, 26, .2); background: #f8efd9; box-sizing: border-box; }
.rp-img.n0 { transform: rotate(4deg) translate(6px, 5px); }
.rp-img.n1 { transform: rotate(-3deg) translate(-3px, 3px); }
.rp-img.n2 { transform: rotate(.5deg); }
.rp-count { position: absolute; z-index: 1; right: 3px; top: 1px; background: #3b2a1a; color: #fffaf0; font-size: 11px; font-weight: 800; border-radius: 999px; padding: 0 7px; }
.rp-empty { display: flex; align-items: center; justify-content: center; height: 92px; border: 2px dashed #b89b72; border-radius: 6px; background: #f8efd9; color: #6e5538; font-family: var(--hand); font-size: 14px; text-align: center; padding: 6px; }
.rp-empty.big { height: auto; padding: 28px 14px; }
.rp-name { font-family: var(--hand); font-size: 16px; line-height: 1.1; }
.rp-meta { display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
.rp-price { font-family: var(--display); font-size: 18px; line-height: 1; white-space: nowrap; }
.rp-price.big { font-size: 26px; }
.rp-price .small { font-family: var(--hand); font-size: 13px; color: #6e5538; }
.rp-chip { display: inline-flex; align-items: center; border: 1.5px solid #3b2a1a; border-radius: 999px; padding: 0 8px; font-family: var(--hand); font-size: 13px; background: #f8efd9; white-space: nowrap; }
.rp-chip.ok { background: #dfe9cc; }
.rp-chip.full { background: #ead8d2; color: #7a2f20; border-color: #7a2f20; }
.rp-bldg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.rp-bimg { display: block; width: 100%; height: 88px; border-radius: 7px; border: 2px solid #3b2a1a; box-sizing: border-box; }
.rp-cap { font-family: var(--hand); font-size: 13px; text-align: center; color: #6e5538; }
.rp-wrap { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 60; display: flex; align-items: flex-start; justify-content: center; background: rgba(31, 24, 16, .5); padding: 16px; }
.rp-album { position: relative; width: 100%; max-width: 560px; height: 82vh; background: #fffaf0; color: #3b2a1a; border: 3px solid #3b2a1a; border-radius: 18px;
  box-shadow: 0 14px 34px rgba(40, 28, 16, .3), 4px 5px 0 rgba(59, 42, 26, .22); display: flex; flex-direction: column; overflow: hidden; }
.rp-ahead { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px 10px; border-bottom: 2px dashed #dcc8a0; flex: none; }
.rp-atitles { flex: 1; min-width: 0; }
.rp-atitles .h3 { font-family: var(--display); font-size: 26px; line-height: 1.05; }
.rp-ahead .x { width: 40px; height: 40px; font-size: 28px; line-height: 40px; text-align: center; flex: none; }
.rp-jump { white-space: nowrap; padding: 10px 16px 4px; flex: none; }
.rp-jchip { display: inline-block; margin-right: 6px; border: 2px solid #3b2a1a; border-radius: 999px; padding: 1px 10px; font-family: var(--hand); font-size: 15px; background: #f8efd9; }
.rp-abody { flex: 1; min-height: 0; padding: 6px 20px 0; box-sizing: border-box; }
.rp-gh { margin: 14px 0 6px; font-family: var(--display); font-size: 22px; }
.rp-pol { margin: 0 0 16px; background: #fff; padding: 8px 8px 0; border: 2px solid #3b2a1a; border-radius: 4px; box-shadow: 3px 4px 0 rgba(59, 42, 26, .2); }
.rp-pimg { display: block; width: 100%; }
.rp-pcap { display: flex; justify-content: space-between; font-family: var(--hand); font-size: 15px; padding: 4px 2px 6px; color: #6e5538; }
.rp-facts { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 8px; }
.rp-afoot { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 16px calc(12px + env(safe-area-inset-bottom)); border-top: 2px dashed #dcc8a0; background: #fffaf0; }
.rp-ask { font-family: var(--hand); font-size: 18px; padding: 6px 16px; border-radius: 12px; background: #b5462f; color: #fff; border: 2px solid #3b2a1a; box-shadow: 2px 3px 0 #3b2a1a; }

/* 利物浦天气（网页 weather.css）+ 云（网页 .clouds） */
.wx-chip { right: 10px; z-index: 11; display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 9px; border: 2.5px solid var(--ink); border-radius: 16px; background: var(--panel); color: var(--ink);
  box-shadow: 0 4px 12px rgba(40, 28, 16, .16); font-size: 14px; line-height: 1.2; }
.wx-ico { width: 28px; height: 28px; flex: none; }
.wx-txt { display: flex; flex-direction: column; min-width: 0; }
.wx-l1 { font-size: 11.5px; color: var(--ink-soft); white-space: nowrap; }
.wx-l2 { font-family: var(--hand); font-size: 17px; white-space: nowrap; }
.wx-l2 .b { font: 800 18px var(--body); }
.wx-l2 .i { font-size: 13px; color: #b5462f; }
.wx-pop { right: 10px; z-index: 12; width: 300px; max-width: calc(100% - 20px); display: flex; flex-direction: column; gap: 8px; padding: 12px 14px 14px; border: 2.5px solid var(--ink); border-radius: 16px;
  background: var(--panel); color: var(--ink); box-shadow: var(--lift); font-size: 13.5px; line-height: 1.5; }
.wx-ph { display: flex; align-items: center; gap: 8px; }
.wx-ph .b { flex: 1; font-family: var(--hand); font-size: 19px; line-height: 1.15; }
.wx-x { font-size: 24px; line-height: 1; padding: 0 2px; }
.wx-tip { font-family: var(--hand); font-size: 16px; background: rgba(242, 193, 78, .25); border-radius: 10px; padding: 5px 9px; }
.wx-dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; }
.wx-dl .dt { color: var(--ink-soft); }
.wx-dl .dd { font-weight: 700; }
.wx-dl .soft { font-weight: 400; color: var(--ink-soft); }
.wx-src { font-size: 11.5px; color: var(--ink-soft); }
.wx-next { align-self: flex-start; border: 2px solid var(--ink); border-radius: 999px; padding: 2px 12px; font-family: var(--hand); font-size: 15px; }

.clouds { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; overflow: hidden; z-index: 1; }
.cloud { position: absolute; left: -280px; width: 240px; height: 76px; opacity: .5;
  background: radial-gradient(closest-side, #fff 70%, transparent) 0 18px / 100px 56px no-repeat, radial-gradient(closest-side, #fff 70%, transparent) 60px 0 / 120px 76px no-repeat,
    radial-gradient(closest-side, #fff 70%, transparent) 130px 16px / 105px 58px no-repeat; animation: drift linear infinite; }
.cloud.c1 { top: 6%; animation-duration: 110s; animation-delay: -30s; }
.cloud.c2 { top: 58%; animation-duration: 140s; animation-delay: -90s; }
@keyframes drift { from { transform: translateX(0); } to { transform: translateX(1900px); } }
.clouds.wx-cloudy .cloud { opacity: .72; filter: grayscale(.35) brightness(.94); }
.clouds.wx-windy .cloud { animation-duration: 55s; }
.wx-fx { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 2; pointer-events: none; overflow: hidden; }
.wx-fx::before, .wx-fx::after { content: ""; position: absolute; left: -40px; top: -40px; right: -40px; bottom: -40px; opacity: 0; }
.wx-fx.wx-night { background-color: rgba(28, 36, 72, .16); }
.wx-fx.wx-fog::before { opacity: 1; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(255,255,255,.5), rgba(255,255,255,.18) 45%, rgba(255,255,255,.45)); }
.wx-fx.wx-rain::before, .wx-fx.wx-storm::before, .wx-fx.wx-drizzle::before {
  opacity: .5; background-image: repeating-linear-gradient(105deg, transparent 0 22px, rgba(61, 127, 166, .55) 22px 23.5px, transparent 23.5px 47px),
    repeating-linear-gradient(100deg, transparent 0 37px, rgba(61, 127, 166, .4) 37px 38px, transparent 38px 71px);
  background-size: 140px 70px, 190px 95px; animation: wx-rain .55s linear infinite; }
.wx-fx.wx-drizzle::before { opacity: .28; animation-duration: .9s; }
.wx-fx.wx-storm::after { opacity: 0; background: #fffbe6; animation: wx-flash 9s infinite; }
.wx-fx.wx-snow::before { opacity: .9; background-image: radial-gradient(circle, #fff 0 2px, transparent 2.6px), radial-gradient(circle, rgba(255,255,255,.85) 0 1.4px, transparent 2px);
  background-size: 90px 90px, 55px 55px; background-position: 0 0, 25px 30px; animation: wx-snow 9s linear infinite; }
@keyframes wx-rain { to { background-position: -30px 70px, -25px 95px; } }
@keyframes wx-snow { to { background-position: 30px 90px, 0 140px; } }
@keyframes wx-flash { 0%, 91%, 94%, 100% { opacity: 0; } 92%, 93.5% { opacity: .35; } }

/* 对比栏（网页 .tray，手机上在底部按钮上面）+ 对比表（网页 .cmp） */
.tray { left: 8px; right: 8px; bottom: calc(66px + env(safe-area-inset-bottom)); z-index: 12; display: flex; align-items: center; gap: 8px; padding: 8px 10px; flex-wrap: wrap; justify-content: center; }
.lbl2 { font-family: var(--hand); font-size: 16px; }
.tchip { display: flex; align-items: center; gap: 4px; padding: 3px 4px 3px 8px; border-radius: 999px; background: var(--panel-2); border: 1.5px solid var(--line); font-size: 13px; max-width: 150px; }
.tchip .tn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tchip .tx { width: 20px; text-align: center; font-size: 15px; }
.tgo { font-family: var(--hand); font-size: 17px; padding: 5px 14px; border-radius: 10px; border: 2px solid var(--ink); background: var(--accent); color: var(--accent-ink); }
.tgo.off { opacity: .45; }
.tclr { font-size: 12.5px; text-decoration: underline; color: var(--ink-soft); }
.cmp-wrap { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: flex-start; justify-content: center; background: rgba(31, 22, 12, .16); padding: 16px; }
.cmp { position: relative; width: 100%; max-height: 80vh; background: #fffaf0; color: #3b2a1a; border: 3px solid #3b2a1a; border-radius: 18px; box-shadow: var(--lift-hi); display: flex; flex-direction: column; overflow: hidden; }
.cmp-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 2px dashed #dcc8a0; flex: none; }
.cmp-top .h2 { font-family: var(--display); font-size: 26px; }
.cmp .x { width: 34px; height: 34px; font-size: 28px; line-height: 34px; text-align: center; }
.cmp-scroll { flex: 1; min-height: 0; max-height: calc(80vh - 64px); }
.cmp-grid { display: inline-flex; flex-direction: column; min-width: 100%; }
.cmp-row { display: flex; }
.cmp-row > view { flex: none; padding: 8px 9px; border-bottom: 1px solid #ecdcbc; font-size: 13px; line-height: 1.45; box-sizing: border-box; }
.cmp-row .rl { width: 92px; font-size: 11.5px; font-weight: 700; letter-spacing: .05em; color: #6e5538; background: #f8efd9; }
.cmp-row .hd, .cmp-row .v, .cmp-row .act { width: 150px; display: flex; flex-direction: column; gap: 4px; }
.hd .n { width: 26px; height: 26px; border-radius: 50%; background: #2c5c8a; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; }
.hd .b { font-family: var(--display); font-size: 19px; line-height: 1.05; }
.hd .s { font-size: 12px; color: #6e5538; }
.v .vb { font-size: 15px; font-weight: 700; }
.v.na { color: #a08b6a; }
.v.na .vb { font-size: 13px; font-weight: 400; }
.v.small { font-size: 12.5px; }
.best { align-self: flex-start; font-size: 11px; font-weight: 800; color: #fff; background: #2f7a33; border-radius: 999px; padding: 0 7px; }
.cmp-row.last > view { border-bottom: 0; padding-bottom: 16px; }
.act .cta { font-size: 15px; align-self: flex-start; }
.act .rm { font-size: 12.5px; text-decoration: underline; color: #6e5538; }
.cmp-note { padding: 10px 16px 14px; font-size: 11.5px; color: #6e5538; }

/* 我的专业（网页 subject-dock.css） */
.subject-dock { position: absolute; left: 0; top: 38%; z-index: 16; }
.subject-tab { width: 46px; min-height: 114px; padding: 10px 7px; display: flex; flex-direction: column; align-items: center; gap: 6px; border: 2px solid var(--ink); border-left: 0;
  border-radius: 0 16px 16px 0; background: var(--panel); color: var(--ink); box-shadow: 2px 4px 12px rgba(59, 42, 26, .18); font-family: var(--hand); font-size: 17px; }
.subject-tab.on { background: var(--panel-2); }
.stl { writing-mode: vertical-rl; letter-spacing: 3px; }
.sts { font: 700 10px/1.3 var(--body); color: var(--accent); white-space: nowrap; }
.sar { font: 26px/20px var(--body); }
.subject-panel { position: fixed; left: 56px; right: 12px; z-index: 22; padding: 14px; max-height: 70vh; overflow-y: auto; }
.sp-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.h2s { font: 700 21px/1.3 var(--hand); }
.sp-close { min-height: 40px; display: flex; align-items: center; padding: 7px 12px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--panel-2); font: 600 13px var(--body); }
.subject-intro { font-size: 13px; line-height: 1.6; color: var(--ink-soft); margin: 8px 0 14px; }
.subject-panel .fsel { margin-top: 4px; min-height: 48px; }
.subject-panel .cur { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.subj-list { max-height: 260px; margin-top: 4px; }
.subjinfo { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; background: var(--panel-2); border: 1.5px dashed var(--line); border-radius: 12px; font-size: 13px; line-height: 1.45; }
.sshow { align-self: flex-start; font-family: var(--hand); font-size: 16px; padding: 3px 12px; border-radius: 999px; border: 2px solid var(--ink); background: var(--accent); color: var(--accent-ink); min-height: 40px; display: flex; align-items: center; }
.subject-footnote { font-size: 12px; color: var(--ink-soft); line-height: 1.6; margin-top: 12px; }

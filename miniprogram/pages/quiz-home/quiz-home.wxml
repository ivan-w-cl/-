<view class="wrap">
  <view wx:if="{{step < 0}}" class="card intro">
    <view class="tape"></view>
    <view class="muted">Liverpool Home Match · 利物浦找房指南</view>
    <view class="h1">🏠 {{T.homeQuiz}}</view>
    <view class="lede">{{T.homeIntro}}</view>
    <button class="btn main" bindtap="start">{{T.start}} ↗</button>
    <button wx:if="{{hasSaved}}" class="btn" bindtap="showSaved">{{T.viewResult}}</button>
  </view>

  <block wx:else>
    <view class="dots"><view wx:for="{{dots}}" wx:key="index" class="d {{item ? 'on' : ''}}"></view></view>
    <view class="muted center">{{progress}}<text wx:if="{{q.multi}}"> · {{T.multiHint}}</text></view>
    <view class="h1 qtitle">{{q.q}}</view>
    <view wx:if="{{q.hint}}" class="fine hint">{{q.hint}}</view>
    <view wx:for="{{q.opts}}" wx:key="id" class="opt {{selected[item.id] ? 'on' : ''}}" data-id="{{item.id}}" bindtap="pick">
      <view class="emoji">{{item.emoji}}</view>
      <view class="grow"><view class="label">{{item.label}}</view><view class="muted">{{item.detail}}</view></view>
      <view class="tick">{{selected[item.id] ? '✓' : ''}}</view>
    </view>
    <view class="row nav">
      <button class="btn grow" bindtap="back">← {{T.back}}</button>
      <button wx:if="{{q.multi || isLast}}" class="btn main grow" disabled="{{!canNext}}" bindtap="next">{{isLast ? T.finish : T.next}} →</button>
    </view>
  </block>
</view>

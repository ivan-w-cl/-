.sv { width: 100%; background: #fffaf0; border: 3rpx solid #3b2a1a; border-radius: 20rpx; margin: 16rpx 0; }
.table { display: inline-block; min-width: 100%; }
.tr { display: flex; flex-direction: row; border-bottom: 2rpx solid rgba(59,42,26,.12); }
.tr.alt { background: #f9f1df; }
.th { width: 200rpx; flex-shrink: 0; padding: 16rpx; font-size: 24rpx; color: #7a6a58; }
.td { width: 210rpx; flex-shrink: 0; padding: 16rpx; font-size: 26rpx; }
.hd { display: flex; flex-direction: column; align-items: flex-start; }
.hname { font-weight: 700; font-size: 26rpx; margin-top: 8rpx; }

<view class="wrap">
  <view wx:if="{{!ready}}" class="card">
    <view class="h2">{{T.resultTitle}}</view>
    <view class="muted">—</view>
    <button class="btn main" bindtap="goLife">{{T.lifeQuiz}}</button>
  </view>
  <block wx:else>
    <view class="card rc" style="background: {{color}}">
      <view class="tape"></view>
      <view class="muted">{{source === 'life' ? T.lifeCharacter : T.resultTitle}}</view>
      <view class="row"><view class="stamp">{{stamp}}</view><view class="h1 grow">{{title}}</view></view>
      <view wx:if="{{quote}}" class="quote">“{{quote}}”</view>
      <view class="desc">{{desc}}</view>
      <view wx:if="{{keywords.length}}" class="row wrapflex"><view wx:for="{{keywords}}" wx:key="index" class="chip">#{{item}}</view></view>
      <view wx:for="{{day}}" wx:key="index" class="dayrow"><text class="time">{{item.time}}</text> {{item.title}}</view>
    </view>

    <view class="h2 sec">{{T.top3}}</view>
    <view wx:if="{{!picks.length}}" class="card muted">{{T.noPicks}}</view>
    <view wx:for="{{picks}}" wx:key="id" class="card pick" data-id="{{item.id}}" bindtap="openHome">
      <view class="row">
        <view class="num top">{{item.n}}</view>
        <view class="grow"><view class="name">★{{item.rank}} {{item.name}}</view><view class="muted">{{item.areaText}}</view></view>
      </view>
      <view class="price">{{item.price}}<text wx:if="{{item.historicalUnavailable}}" class="badge">{{T.soldOut}}</text></view>
      <view class="divider"></view>
      <view wx:for="{{item.reasons}}" wx:for-item="r" wx:key="key" class="reason">{{r.ico}} {{r.text}}</view>
      <view wx:if="{{item.trade}}" class="trade">⚖️ {{T.tradeoff}}：{{item.trade.text}}</view>
    </view>

    <button class="btn main" bindtap="compare" disabled="{{picks.length < 2}}">⚖️ {{T.compare3}}</button>
    <view class="row">
      <button class="btn grow gap" bindtap="onMap">🗺️ {{T.onMap}}</button>
      <button class="btn grow" bindtap="consult">💬 {{T.consult}}</button>
    </view>
    <button class="btn" bindtap="retake">↺ {{T.retake}}</button>
    <view class="fine">{{T.priceNote}} {{T.walkNote}}</view>
  </block>
</view>

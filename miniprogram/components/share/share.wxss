/* 网页 share-cards.css（手机上整屏） */
.sc-wrap { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 60; background: #fffaf0; display: flex; box-sizing: border-box; }
.sc-box { position: relative; width: 100%; height: 100%; overflow-y: auto; background: #fffaf0; color: #3b2a1a; padding: 14px 18px 18px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; }
.sc-box.en { --display: 'Gochi Hand', 'ZCOOL KuaiLe', cursive; --hand: 'Patrick Hand', 'ZCOOL KuaiLe', cursive; }
.sc-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.sc-head .h3 { font-family: var(--display); font-size: 26px; line-height: 1.1; }
.sc-head .x { width: 40px; height: 40px; font-size: 28px; line-height: 40px; text-align: center; color: #3b2a1a; flex: none; }
.sc-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
.sc-tab { border: 2px solid #3b2a1a; border-radius: 999px; padding: 3px 12px; background: #f8efd9; color: #3b2a1a; font-family: var(--hand); font-size: 16px; }
.sc-tab.on { background: #f2c14e; box-shadow: 2px 3px 0 #3b2a1a; }
.sc-stage { position: relative; background: #e9dcbc; border: 2px dashed #b89b72; border-radius: 12px; padding: 10px; display: flex; justify-content: center; }
.sc-img { display: block; width: 100%; max-width: 380px; height: 0; padding-bottom: 125%; border-radius: 6px; box-shadow: 0 8px 20px rgba(40, 28, 16, .25); background: #f1e4c3; }
image.sc-img { height: auto; padding-bottom: 0; }
.sc-box.busy .sc-img { opacity: .5; }
.sc-hold { font-size: 12px; color: #6e5538; text-align: center; }
.sc-acts { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.sc-btn { display: flex; align-items: center; min-height: 40px; border: 2px solid #3b2a1a; border-radius: 10px; padding: 4px 14px; background: #fffaf0; color: #3b2a1a; font-family: var(--hand); font-size: 17px; }
.sc-btn.main { background: #b5462f; color: #fff; box-shadow: 2px 3px 0 #3b2a1a; }
.sc-canvas { position: fixed; left: -3000px; top: 0; width: 1080px; height: 1350px; }

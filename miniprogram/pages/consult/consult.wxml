<view class="wrap">
  <view class="card">
    <view class="tape"></view>
    <view class="h1">💬 {{T.consultTitle}}</view>
    <view class="lede">{{T.consultLead}}</view>
    <view class="divider"></view>
    <view class="muted">{{T.consultCtx}}：</view>
    <view class="kv"><text class="muted">{{T.consultHomes}}：</text>
      <text wx:if="{{!homes.length}}">{{T.consultNone}}</text>
      <view wx:for="{{homes}}" wx:key="id" class="chip on">{{item.n}} · {{item.name}}</view>
    </view>
    <view class="kv"><text class="muted">{{T.consultQuiz}}：</text>{{quiz || T.consultNone}}</view>
  </view>

  <!-- 进入微信官方客服会话；session-from 会随 user_enter_tempsession 事件推送到 consult-server 的 /api/wx/callback -->
  <button class="btn main" open-type="contact" session-from="{{sessionFrom}}" show-message-card="{{homes.length > 0}}"
          send-message-title="{{sendTitle}}" send-message-path="{{sendPath}}" bindcontact="onContact">{{T.consultBtn}}</button>

  <view class="card">
    <view wx:for="{{T.consultSteps}}" wx:key="index" class="step"><text class="num top">{{index + 1}}</text>{{item}}</view>
    <view class="fine">{{T.consultFine}}</view>
  </view>
</view>

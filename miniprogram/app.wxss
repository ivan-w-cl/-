/* 全局：和网页版 :root 的颜色、字体一样 */
page {
  --paper: #e9dcbc; --desk: #d9c9a3; --panel: #fffaf0; --panel-2: #f8efd9; --ink: #3b2a1a; --ink-soft: #6e5538;
  --line: #dcc8a0; --accent: #b5462f; --accent-ink: #ffffff; --home: #2c5c8a;
  --lift: 0 14px 34px rgba(40, 28, 16, .24), 4px 5px 0 rgba(59, 42, 26, .22);
  --lift-hi: 0 34px 70px rgba(31, 22, 12, .38), 0 10px 22px rgba(31, 22, 12, .26), 6px 8px 0 rgba(59, 42, 26, .25);
  --display: 'Gochi Hand', 'ZCOOL KuaiLe', cursive; --hand: 'Patrick Hand', 'ZCOOL KuaiLe', cursive;
  --body: 'Nunito', -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  height: 100%; background: var(--desk); color: var(--ink); font-family: var(--body); font-size: 14.5px; line-height: 1.45;
}
view, text, button, input { box-sizing: border-box; }
button { margin: 0; padding: 0; line-height: inherit; font: inherit; color: inherit; background: none; border-radius: 0; }
button::after { border: none; }

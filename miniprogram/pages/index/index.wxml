<!-- 首页：布局照搬网页版手机布局（标题栏、地图、底部三个按钮、卡片、两个抽屉） -->
<view class="app">
  <canvas type="2d" id="map" class="map" disable-scroll="true"
    bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></canvas>

  <!-- 天气画在地图上：雨、雪、雾、夜晚；两朵云（网页 .clouds / weather.css 的 .wx-fx） -->
  <view class="clouds {{fx}}"><view class="cloud c1"></view><view class="cloud c2"></view></view>
  <view class="wx-fx {{fx}}"></view>

  <!-- 标题栏（放在微信胶囊按钮左边） -->
  <view class="float panel brandbar" style="top:{{nav.top}}px;right:{{nav.right}}px;min-height:{{nav.h}}px">
    <text class="h1">{{T.title}}</text>
    <view class="langs">
      <view class="lb {{lang === 'en' ? 'on' : ''}}" data-l="en" bindtap="setLang">EN</view>
      <view class="lb {{lang === 'zh' ? 'on' : ''}}" data-l="zh" bindtap="setLang">中文</view>
    </view>
    <view class="infobtn" bindtap="toggleInfo">i</view>
  </view>
  <!-- 利物浦天气（标题栏下面靠右，和网页手机版一样） -->
  <view wx:if="{{wx}}" class="float wx-chip" style="top:{{nav.top + nav.h + 8}}px" bindtap="toggleWeather">
    <image src="{{wx.icon}}" class="wx-ico"></image>
    <view class="wx-txt"><view class="wx-l1">{{wx.l1}}</view><view class="wx-l2"><text class="b">{{wx.temp}}</text><text> {{wx.label}}</text><text wx:if="{{wx.sample}}" class="i"> · {{wx.sample}}</text></view></view>
  </view>
  <view wx:if="{{wx && wxOpen}}" class="float wx-pop" style="top:{{nav.top + nav.h + 74}}px">
    <view class="wx-ph"><image src="{{wx.icon}}" class="wx-ico"></image><text class="b">{{wx.title}}</text><view class="wx-x" bindtap="toggleWeather">×</view></view>
    <view class="wx-tip">{{wx.tip}}</view>
    <view class="wx-dl"><block wx:for="{{wx.rows}}" wx:key="index"><text class="dt">{{item[0]}}</text><text class="dd">{{item[1]}} <text class="soft">{{item[2] || ''}}</text></text></block></view>
    <view class="wx-src">{{wx.src}}</view>
    <view wx:if="{{wx.another}}" class="wx-next" bindtap="nextWeather">{{wx.another}}</view>
  </view>
  <view wx:if="{{info}}" class="float panel infopop" style="top:{{nav.top + nav.h + 8}}px"><text>{{T.info}}</text></view>

  <!-- 我的专业：左边的小标签 + 面板（网页 subject-dock） -->
  <view class="subject-dock">
    <view class="subject-tab {{subj.open ? 'on' : ''}}" bindtap="toggleSubject"><text class="stl">{{subj.k.title}}</text><text wx:if="{{subj.set}}" class="sts">{{subj.k.selected}}</text><text class="sar">›</text></view>
  </view>
  <view wx:if="{{subj.open}}" class="panel subject-panel" style="top:{{nav.top + nav.h + 8}}px" catchtouchmove="noop">
    <view class="sp-head"><text class="h2s">{{subj.k.title}}</text><view class="sp-close" bindtap="closeSubject">{{subj.k.close}}</view></view>
    <view class="subject-intro">{{subj.k.intro}}</view>
    <text class="flbl small">{{subj.k.label}}</text>
    <view class="fsel" bindtap="toggleSubjList"><text class="cur">{{subj.current}}</text><text class="caret">⌄</text></view>
    <scroll-view wx:if="{{subj.listOpen}}" scroll-y="true" class="fs-list subj-list"><view wx:for="{{subj.list}}" wx:key="id" class="fs-opt {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="pickSubject">{{item.name}}</view></scroll-view>
    <view wx:if="{{subj.info}}" class="subjinfo"><view>{{subj.info}}</view><view class="sshow" bindtap="showBuildings">{{subj.show}}</view></view>
    <view class="subject-footnote">{{subj.k.foot}}</view>
  </view>

  <!-- 缩放 -->
  <view class="float zoom">
    <view class="zb {{canZoomIn ? '' : 'off'}}" bindtap="zoomIn">+</view>
    <view class="zb {{canZoomOut ? '' : 'off'}}" bindtap="zoomOut">−</view>
    <view class="zb fit {{canZoomOut ? '' : 'off'}}" bindtap="zoomFit">{{T.zfit}}</view>
  </view>

  <!-- 🏁 抢房计划入口（左下角，底部按钮上面） -->
  <view wx:if="{{!card}}" class="float planfab" bindtap="openPlan">🏁 {{T.planBtn}}<text wx:if="{{planCount}}" class="pf-n">{{planCount}}</text></view>

  <!-- 底部三个按钮 -->
  <view class="mbar">
    <view class="mb match" bindtap="openMatch">{{T.matchBtn}}</view>
    <view class="mb" data-s="controls" bindtap="openSheet">{{T.filters}}</view>
    <view class="mb" data-s="homes" bindtap="openSheet">{{homesCount}}</view>
  </view>

  <!-- 公寓 / 地点卡片 -->
  <view wx:if="{{card}}" class="card {{expanded ? 'sheet' : 'compact'}}" catchtouchmove="noop">
    <view class="x" bindtap="closeCard">×</view>
    <view class="tag" style="background:{{card.place ? card.tagColor : '#2c5c8a'}}">{{card.tag}}</view>
    <view class="h3">{{card.name}}</view>
    <block wx:if="{{card.place}}"><view class="txt">{{card.text}}</view></block>
    <block wx:else>
      <block wx:if="{{!expanded}}">
        <view class="compact-facts"><text class="strong">{{card.price}}</text><text>{{card.walk}}</text></view>
        <view class="compact-note">{{T.compactNote || ''}}</view>
        <view wx:if="{{card.rooms.hint}}" class="rp-hint">{{card.rooms.hint}}</view>
      </block>
      <block wx:else>
        <view class="addr">{{card.addr}}</view>
        <view class="txt">{{card.text}}</view>
        <view class="rp">
          <view class="rp-title">{{card.rooms.title}}</view>
          <view class="rp-note">{{card.rooms.note}}</view>
          <scroll-view scroll-x="true" class="rp-strip" enhanced="true" show-scrollbar="false">
            <view wx:for="{{card.rooms.types}}" wx:key="i" class="rp-card" data-i="{{item.i}}" bindtap="openAlbum">
              <view class="rp-stack">
                <block wx:if="{{item.stack.length}}">
                  <text class="rp-count">{{item.count}}</text>
                  <image wx:for="{{item.stack}}" wx:key="*this" wx:for-item="u" wx:for-index="j" src="{{u}}" mode="aspectFill" class="rp-img n{{j}}" lazy-load="true"></image>
                </block>
                <view wx:else class="rp-empty">{{item.pending}}</view>
              </view>
              <view class="rp-name">{{item.name}}</view>
              <view class="rp-meta"><text class="rp-price">{{item.price}}<text class="small">{{card.rooms.perWeek}}</text></text><text class="rp-chip {{item.ok ? 'ok' : 'full'}}">{{item.status}}</text></view>
            </view>
          </scroll-view>
          <block wx:if="{{card.rooms.building.length}}">
            <view class="rp-sub">{{card.rooms.sub}}</view>
            <view class="rp-bldg"><view wx:for="{{card.rooms.building}}" wx:key="url" class="rp-fig"><image src="{{item.url}}" mode="aspectFill" class="rp-bimg" lazy-load="true"></image><view class="rp-cap">{{item.label}}</view></view></view>
          </block>
          <view wx:if="{{card.rooms.src}}" class="rp-src">{{card.rooms.src}}</view>
        </view>
        <view class="walks"><text wx:for="{{card.walks}}" wx:key="index" class="wk">{{item}}</text></view>
        <view class="facts"><view wx:for="{{card.facts}}" wx:key="index" wx:for-item="f" class="fact"><text wx:for="{{f}}" wx:key="index" wx:for-item="p" class="{{p.b ? 'b' : ''}}">{{p.t}}</text></view></view>
        <view class="actions2">
          <view class="ha {{card.fav ? 'on' : ''}}" bindtap="toggleFav">{{card.fav ? '★ ' + T.saved : '☆ ' + T.save}}</view>
          <button class="ha" open-type="share">{{T.share}}</button>
        </view>
        <view class="src">{{card.src}}</view>
      </block>
      <view class="acts">
        <view class="cta" bindtap="ask">{{expanded ? T.ask : T.compactAsk}}</view>
        <view class="detail-toggle" bindtap="toggleExpand">{{expanded ? T.collapseDetails : T.expandDetails}}</view>
        <view wx:if="{{expanded}}" class="cmpb {{card.cmp ? 'on' : ''}}" bindtap="toggleCompare">{{card.cmp ? T.cmpAdded : T.cmpAdd}}</view>
        <view class="cmpb planb {{card.inPlan ? 'on' : ''}}" bindtap="addToPlan">🏁 {{card.inPlan ? T.inPlan : T.addPlan}}</view>
      </view>
    </block>
  </view>

  <!-- 房型相册 -->
  <view wx:if="{{album}}" class="rp-wrap" style="padding-top:{{nav.top + nav.h + 8}}px" catchtouchmove="noop" bindtap="closeAlbum">
    <view class="rp-album" catchtap="noop">
      <view class="rp-ahead"><view class="rp-atitles"><view class="h3">{{album.title}}</view><view class="rp-note">{{album.sub}}</view></view><view class="x" bindtap="closeAlbum">×</view></view>
      <scroll-view wx:if="{{album.groups.length}}" scroll-x="true" class="rp-jump" enhanced="true" show-scrollbar="false"><view wx:for="{{album.groups}}" wx:key="id" class="rp-jchip" data-id="{{item.id}}" bindtap="albumJump">{{item.chip}}</view></scroll-view>
      <scroll-view scroll-y="true" class="rp-abody" scroll-into-view="{{albumTo}}" scroll-with-animation="true" enhanced="true" show-scrollbar="false">
        <block wx:for="{{album.groups}}" wx:key="id" wx:for-item="g">
          <view class="rp-gh" id="{{g.id}}">{{g.label}}</view>
          <view wx:for="{{g.photos}}" wx:key="url" class="rp-pol" data-url="{{item.url}}" bindtap="albumPreview"><image src="{{item.url}}" mode="widthFix" class="rp-pimg"></image><view class="rp-pcap"><text>{{g.label}}</text><text>{{item.cap}}</text></view></view>
        </block>
        <view wx:if="{{album.empty}}" class="rp-empty big">{{album.empty}}</view>
        <view class="rp-facts"><text wx:for="{{album.facts}}" wx:key="index" class="rp-chip {{item.cls}}">{{item.t}}</text></view>
        <view class="pad-bottom"></view>
      </scroll-view>
      <view class="rp-afoot"><text class="rp-price big">{{album.price}}<text class="small">{{album.perWeek}}</text></text><view class="rp-ask" bindtap="albumAsk">{{album.ask}}</view></view>
    </view>
  </view>

  <!-- 我的专家群：右下角气泡 -->
  <view wx:if="{{fab && !groupShow}}" class="bh-fab {{fab.waiting ? 'waiting' : ''}}" bindtap="openGroup">
    <text class="bh-fab-ico">💬</text><text class="bh-fab-label">{{fab.label}}</text><text wx:if="{{fab.dot}}" class="bh-dot">{{fab.dot}}</text>
  </view>
  <group show="{{groupShow}}" home="{{groupHome}}" lang="{{lang}}" bind:close="closeGroup"></group>
  <match id="match" lang="{{lang}}" filter-ids="{{filterIds}}" subject="{{subjectObj}}" pad-top="{{nav.top + nav.h + 4}}"
    bind:map="onMatchMap" bind:card="onMatchCard" bind:ask="onMatchAsk" bind:compare="onMatchCompare" bind:subject="onMatchSubject" bind:resetfilters="onMatchResetFilters" bind:fun="onMatchFun" bind:share="onShareCard"></match>
  <fun id="fun" lang="{{lang}}" pad-top="{{nav.top + nav.h + 4}}" bind:map="onFunMap" bind:card="onMatchCard" bind:ask="onMatchAsk" bind:share="onShareCard" bind:home="onFunHome" bind:result="onFunResult"></fun>
  <share id="share" lang="{{lang}}" pad-top="{{nav.top + nav.h + 4}}"></share>
  <plan id="plan" lang="{{lang}}" pad-top="{{nav.top + nav.h + 4}}" bind:card="onMatchCard" bind:ask="onMatchAsk" bind:close="onPlanClose" bind:copied="onPlanClose"></plan>

  <!-- 对比栏（网页 .tray） -->
  <view wx:if="{{tray.length && !cmp && !sheet && !subj.open}}" class="float panel tray">
    <text class="lbl2">{{trayT.lbl}}</text>
    <view wx:for="{{tray}}" wx:key="id" class="tchip"><text class="tn">{{item.n}}. {{item.name}}</text><text class="tx" data-id="{{item.id}}" bindtap="trayRemove">×</text></view>
    <view class="tgo {{tray.length < 2 ? 'off' : ''}}" bindtap="openCompare">{{trayT.go}}</view>
    <text class="tclr" bindtap="trayClear">{{trayT.clr}}</text>
  </view>

  <!-- 对比表（网页 .cmp） -->
  <view wx:if="{{cmp}}" class="cmp-wrap" style="padding-top:{{nav.top + nav.h + 8}}px" catchtouchmove="noop" bindtap="closeCompare">
    <view class="cmp" catchtap="noop">
      <view class="cmp-top"><text class="h2">{{cmp.title}}</text><view class="x" bindtap="closeCompare">×</view></view>
      <scroll-view scroll-x="true" scroll-y="true" class="cmp-scroll" enhanced="true" show-scrollbar="false">
        <view class="cmp-grid">
          <view class="cmp-row"><view class="rl"></view><view wx:for="{{cmp.heads}}" wx:key="id" class="hd"><text class="n">{{item.n}}</text><text class="b">{{item.name}}</text><text class="s">{{item.area}}</text><text class="s">{{item.addr}}</text></view></view>
          <view wx:for="{{cmp.rows}}" wx:key="label" wx:for-item="r" class="cmp-row"><view class="rl">{{r.label}}</view>
            <view wx:for="{{r.cells}}" wx:key="index" wx:for-item="c" class="v {{c.na ? 'na' : ''}}"><text class="vb">{{c.t}}</text><text wx:if="{{c.unit}}">{{c.unit}}</text><text wx:if="{{c.best}}" class="best">{{cmp.best}}</text></view></view>
          <view class="cmp-row"><view class="rl">{{cmp.desc.label}}</view><view wx:for="{{cmp.desc.cells}}" wx:key="index" class="v small">{{item}}</view></view>
          <view class="cmp-row last"><view class="rl"></view><view wx:for="{{cmp.heads}}" wx:key="id" class="act">
            <view class="cta" data-id="{{item.id}}" bindtap="cmpAsk">{{cmp.ask}}</view><text class="rm" data-id="{{item.id}}" bindtap="cmpMap">{{cmp.map}}</text><text class="rm" data-id="{{item.id}}" bindtap="cmpRemove">{{cmp.rm}}</text></view></view>
        </view>
        <view class="cmp-note">{{cmp.note}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 抽屉：公寓列表 -->
  <view class="sheet-mask" wx:if="{{sheet}}" bindtap="closeSheets"></view>
  <view class="panel drawer homes {{sheet === 'homes' ? 'open' : ''}}" catchtouchmove="noop">
    <view class="phead"><text class="h2">{{T.homesBtn}}</text><view class="pbtn" bindtap="closeSheets">{{T.close}}</view></view>
    <scroll-view scroll-y="true" class="pbody" enhanced="true" show-scrollbar="false">
      <view class="home-search">
        <text class="lbl">{{T.h_search}}</text>
        <input class="search" type="text" placeholder="{{T.h_placeholder}}" value="{{filters.query}}" bindinput="onSearch" confirm-type="search"></input>
        <view class="home-search-row"><text>{{countText}}</text><view class="sbtn {{filters.favoritesOnly ? 'on' : ''}}" bindtap="toggleFavOnly">{{T.h_favorites}}</view></view>
        <text class="local-note">{{T.h_local}}</text>
      </view>
      <view class="pc-sort">
        <text class="flbl">{{T.rankBy}}</text>
        <view class="fsel {{isRanked ? 'ranked' : ''}}" data-k="rank" bindtap="openSelect"><text>{{options.rank.current}}</text><text class="caret">⌄</text></view>
        <view wx:if="{{open === 'rank'}}" class="fs-list">
          <view wx:for="{{options.rank}}" wx:key="v" class="fs-opt {{item.on ? 'on' : ''}}" data-k="rank" data-v="{{item.v}}" bindtap="pick">{{item.label}}</view>
        </view>
        <text wx:if="{{sortNote}}" class="pc-sortnote">{{sortNote}}</text>
      </view>
      <text class="stable-note">{{T.h_stable}}</text>
      <view wx:if="{{!count}}" class="empty-homes"><text>{{T.h_empty}}</text><view class="pbtn" bindtap="resetFilters">{{T.h_reset}}</view></view>
      <block wx:for="{{groups}}" wx:key="title" wx:for-item="g">
        <view class="gh">{{g.title}}</view>
        <view wx:for="{{g.items}}" wx:key="id" class="hrow">
          <view class="hbtn" data-id="{{item.id}}" bindtap="openHome"><text class="n">{{item.n}}</text><text class="nm">{{item.name}}</text></view>
          <view class="fav-mini" data-id="{{item.id}}" bindtap="toggleFav">{{item.fav ? '★' : '☆'}}</view>
          <view class="cbtn {{item.cmp ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleCompare">{{item.cmp ? '✓' : '+'}}</view>
        </view>
      </block>
      <view wx:for="{{ranked}}" wx:key="id" class="hrow {{isRanked ? 'r' : ''}}">
        <text wx:if="{{isRanked}}" class="rk {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</text>
        <view class="hbtn" data-id="{{item.id}}" bindtap="openHome"><text class="n">{{item.n}}</text><text class="nm">{{item.name}}</text><text class="w">{{item.w}}</text></view>
        <view class="fav-mini" data-id="{{item.id}}" bindtap="toggleFav">{{item.fav ? '★' : '☆'}}</view>
        <view class="cbtn {{item.cmp ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleCompare">{{item.cmp ? '✓' : '+'}}</view>
      </view>
      <view class="pad-bottom"></view>
    </scroll-view>
  </view>

  <!-- 抽屉：找公寓（筛选） -->
  <view class="panel drawer controls {{sheet === 'controls' ? 'open' : ''}}" catchtouchmove="noop">
    <view class="phead"><text class="h2">{{T.findHome}}</text><view class="pbtn" bindtap="closeSheets">{{T.close}}</view></view>
    <scroll-view scroll-y="true" class="pbody" enhanced="true" show-scrollbar="false">
      <view class="filter-grid">
        <view class="field" wx:for="{{['budget', 'room', 'destination', 'walk']}}" wx:key="*this" wx:for-item="k">
          <text class="flbl small">{{T['h_' + k]}}</text>
          <view class="fsel" data-k="{{k}}" bindtap="openSelect"><text>{{options[k].current}}</text><text class="caret">⌄</text></view>
          <view wx:if="{{open === k}}" class="fs-list">
            <view wx:for="{{options[k]}}" wx:key="v" wx:for-item="o" class="fs-opt {{o.on ? 'on' : ''}}" data-k="{{k}}" data-v="{{o.v}}" bindtap="pick">{{o.label}}</view>
          </view>
        </view>
      </view>
      <text class="filter-note">{{T.h_note}}</text>
      <view class="filter-footer"><view class="fbtn" bindtap="resetFilters">{{T.h_reset}}</view><view class="fbtn main" bindtap="viewResults">{{viewText}}</view></view>
      <view class="toggles">
        <view wx:for="{{layers}}" wx:key="k" class="chip {{item.on ? '' : 'off'}}" data-k="{{item.k}}" bindtap="toggleLayer"><text class="sw" style="background:{{item.color}}"></text><text>{{item.label}}</text></view>
      </view>
      <view class="zonekey"><view wx:for="{{zones}}" wx:key="k"><text class="zi" style="background:{{item.color}}"></text>{{item.label}}</view></view>
      <view class="pad-bottom"></view>
    </scroll-view>
  </view>
</view>
